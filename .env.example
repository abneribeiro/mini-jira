# Copy to .env and fill in. Never commit .env itself.

# HTTP port the API binds. Must match prometheus/prometheus.yml and curl.md.
PORT=8080

# local | production — selects the slog handler (text vs JSON).
APP_ENV=local

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mini_jira?sslmode=disable

# HS256 signing key, minimum 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-characters
