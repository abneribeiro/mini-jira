# Copy to .env and adjust. Never commit .env itself.
# The API and cmd/migrate load .env from the working directory; real
# environment variables take precedence.

# ---------------------------------------------------------------- server ---

# Public HTTP port of the API.
PORT=8080

# Private listener for /metrics, /health and /livez. Not published by
# docker-compose.yml; Prometheus scrapes it over the compose network.
METRICS_PORT=9091

# local selects the human-readable text log handler; any other value
# (production) selects JSON logs.
APP_ENV=local

# Take the client address from X-Forwarded-For / X-Real-IP. Enable only
# behind a reverse proxy that overwrites those headers: the login rate limiter
# keys on the client address, and a spoofable address defeats it.
TRUST_PROXY_HEADERS=false

# -------------------------------------------------------------- database ---

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mini_jira?sslmode=disable

# ------------------------------------------------------------------ auth ---

# HS256 signing key, minimum 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-characters

# ----------------------------------------------------------------- tests ---

# Enables the repository integration tests (internal/testdb). Use a separate
# database: the tests write and delete rows. `make test-integration` creates
# and migrates it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mini_jira_test?sslmode=disable

# Optional: credentials of an existing admin for scripts/smoke.sh. When unset,
# the smoke test promotes a temporary admin through the Postgres container.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
